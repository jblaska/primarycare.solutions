# Normalize line endings for this repo.
# Git stores everything as LF internally and converts on checkout only
# where a platform genuinely needs it (nothing here does for a static site).
# This stops the two-computer CRLF/LF churn for good.

* text=auto eol=lf

*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.md   text eol=lf
*.svg  text eol=lf
*.json text eol=lf
*.txt  text eol=lf
.nojekyll text eol=lf

# Binary files — never touch these, ever.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.pdf   binary
*.docx  binary
*.pptx  binary
*.xlsx  binary
*.zip   binary
